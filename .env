APP_NAME=CodeIntelligence
APP_VERSION=1.0.0

#DATABASE_MODE=sqlite,postgres
#POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/codeintelligence
DATABASE_MODE=dual
LOCAL_DATABASE_URL=sqlite:///./codeintelligence.db
POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codeintelligence

JAVA_PROJECT_PATH=D:\AIlearning\student-employee-project

AUTO_PROJECT_INITIALIZATION=true


# Jira requirement understanding
JIRA_LLM_ENABLED=true
#
## Default: Choose: ollama or openai
LLM_PROVIDER=openai
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b

# Optional hosted provider. Only required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
