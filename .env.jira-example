# Jira requirement understanding
JIRA_LLM_ENABLED=true

# Default: fully local Ollama provider
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional hosted provider. Only required when LLM_PROVIDER=openai.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
