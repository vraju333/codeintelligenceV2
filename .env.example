APP_NAME=CodeIntelligence
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///./codeintelligence.db
JAVA_PROJECT_PATH=D:/AIlearning/student-employee-project
AUTO_PROJECT_INITIALIZATION=true

# Jira requirement understanding
JIRA_LLM_ENABLED=true

# Choose: ollama or openai
LLM_PROVIDER=ollama

# Local Ollama provider (default/private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI provider (only needed when LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
